#!/usr/bin/env bash
# Synchronize the rendered secrets template with Home Assistant over SSH.

set -u -o pipefail

readonly template='secrets.yaml.optpl'
readonly remote_path='/root/homeassistant/esphome/secrets.yaml'
readonly sentinel=$'\x1f'

usage() {
  printf 'Usage: %s <ssh-host>\n' "${0##*/}" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage
host=$1

for command in optpl git ssh; do
  command -v "$command" >/dev/null 2>&1 || {
    printf 'Required command not found: %s\n' "$command" >&2
    exit 1
  }
done

[[ -f $template ]] || {
  printf 'Template not found: %s\n' "$template" >&2
  exit 1
}

# Appending a non-newline sentinel prevents command substitution from stripping
# the template's trailing newlines.  Remove it afterwards.
if ! rendered_secrets=$(optpl "$template" || exit; printf '%s' "$sentinel"); then
  printf 'Could not render %s.\n' "$template" >&2
  exit 1
fi
rendered_secrets=${rendered_secrets%"$sentinel"}

if ! remote_secrets=$(ssh -l root -- "$host" "cat -- '$remote_path'" || exit; printf '%s' "$sentinel"); then
  printf 'Could not read %s:%s.\n' "$host" "$remote_path" >&2
  exit 1
fi
remote_secrets=${remote_secrets%"$sentinel"}

printf 'Comparing root@%s:%s (existing) with %s (rendered)\n\n' \
  "$host" "$remote_path" "$template"

# git returns 1 for a real diff, so handle that separately from failures.
set +e
git diff --no-index --no-ext-diff --color=always -- \
  <(printf '%s' "$remote_secrets") \
  <(printf '%s' "$rendered_secrets")
diff_status=$?
set -e

case $diff_status in
  0)
    printf '\nSecrets are already synchronized; nothing to do.\n'
    exit 0
    ;;
  1)
    ;;
  *)
    printf 'Could not compare secrets (git diff exited %d).\n' "$diff_status" >&2
    exit "$diff_status"
    ;;
esac

printf '\n'
read -r -p "Overwrite root@$host:$remote_path? [y/N] " response
if [[ $response != y ]]; then
  printf 'Sync aborted.\n'
  exit 0
fi

# The temporary file starts restrictive, then receives the existing target's
# numeric mode before the atomic replacement. This works with BusyBox chmod.
if printf '%s' "$rendered_secrets" | ssh -l root -- "$host" '
  set -eu
  target=/root/homeassistant/esphome/secrets.yaml
  umask 077
  temporary=$(mktemp "${target}.tmp.XXXXXX")
  trap '\''rm -f "$temporary"'\'' EXIT HUP INT TERM
  mode=$(stat -c '%a' "$target")
  cat > "$temporary"
  chmod "$mode" "$temporary"
  mv -f "$temporary" "$target"
  trap - EXIT HUP INT TERM
'; then
  printf 'Synchronized secrets to root@%s:%s.\n' "$host" "$remote_path"
else
  printf 'Sync failed; the remote secrets file was not replaced.\n' >&2
  exit 1
fi
