wifi_ssid: "{{ op://Private/WLAN/network name }}"
wifi_password: "{{ op://Private/WLAN/wireless network password }}"

# Used only if the gateway cannot join the configured Wi-Fi network.
fallback_ap_password: "{{ op://Private/esphome lora/fallback ap }}"

# Used by Home Assistant / ESPHome native API; must be a base64-encoded 32-byte key.
gateway_api_encryption_key: "{{ op://Private/esphome lora/api secret }}"

# Shared by both LoRa nodes. Packet Transport hashes this string into its key.
lora_transport_key: "{{ op://Private/esphome lora/lora secret }}"
